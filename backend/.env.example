# .env.example — ElderCare AI backend environment variable template.
#
# Copy this file to .env and fill in your real values.
# The actual .env file is gitignored and must NEVER be committed.
# Never place real credentials in this file or in render.yaml.
#
# ─── IBM watsonx.ai credentials ───────────────────────────────────────────────
WATSONX_API_KEY=your-ibm-cloud-api-key-here
WATSONX_URL=https://your-region.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-watsonx-project-id-here
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# ─── CORS origins ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local development default — no change needed for local use.
ALLOWED_ORIGINS=http://localhost:3000
# Production example (set in Render dashboard, not here):
# ALLOWED_ORIGINS=https://eldercare-qevopbaq0-code-strome.vercel.app

# ─── Production feature flags ──────────────────────────────────────────────────
# Set both to "true" in Render dashboard for production deployments.
# Leave unset (or "false") for local development.
DISABLE_DOCS=false
MCP_ENABLED=true
